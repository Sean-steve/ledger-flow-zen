# Private staging API: not a production-validated public service.
FROM oven/bun:1 AS dependencies
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production FDOS_RELEASE_MODE=staging
COPY --from=dependencies /app/node_modules ./node_modules
COPY --chown=node:node server/local ./server/local
COPY --chown=node:node scripts/staging ./scripts/staging
USER node
EXPOSE 5012
CMD ["node","server/local/api.mjs"]
