# KEEP THIS FILE PRIVATE. Copy to .env.staging ON A DEDICATED STAGING VPS ONLY.
# Never reuse a production database, production identity or real customer data.
FDOS_STAGE_DOMAIN=staging-finance.example.com
FDOS_STAGE_ACME_EMAIL=ops@example.com
FDOS_STAGE_BASIC_USER=reviewer
# Generate hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'AN_INDEPENDENT_STRONG_PASSWORD'
# Keep the bcrypt hash single quoted to protect its dollar symbols from env expansion.
FDOS_STAGE_BASIC_HASH='$2a$14$REPLACE_WITH_REAL_BCRYPT_HASH'
FDOS_STAGE_DB_PASSWORD=CHANGE_UNIQUE_STAGE_DB_PASSWORD
# URL-encode special password characters for DATABASE_URL. Host and DB must be exact:
DATABASE_URL=postgresql://fdos_stage:CHANGE_UNIQUE_STAGE_DB_PASSWORD@db:5432/fdos_staging
FDOS_STAGE_BOOTSTRAP_EMAIL=reviewer@example.com
# Managed by Compose: no changing these values in staging:
FDOS_RELEASE_MODE=staging
FDOS_STAGING_CONFIRMED=YES
FDOS_STAGE_DATA_POLICY=SYNTHETIC_ONLY
FDOS_API_HOST=0.0.0.0
FDOS_API_PORT=5012
FDOS_FRONTEND_ORIGIN=https://staging-finance.example.com
FDOS_LOCAL_ALLOW_SIGNUP=NO
FDOS_COMM_MODE=preview
FDOS_MPESA_MODE=preview
FDOS_ETIMS_MODE=preview
FDOS_AUTOMATION_LIVE_ENABLED=NO
FDOS_AUTOMATION_LIVE_APPROVED=NO
FDOS_AUTOMATION_TIMEZONE=Africa/Nairobi
# Do not place KRA/Meta/Safaricom/Resend live credentials in this staging file.
