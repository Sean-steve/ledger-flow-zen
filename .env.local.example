# Copy to .env.local (ignored by Git). This is LOCAL DEVELOPMENT ONLY.
# Use an independently generated password; do not commit real credentials.
FDOS_DB_PASSWORD=change-me-generate-random-password
FDOS_DB_PORT=55434
DATABASE_URL=postgresql://fdos_dev:change-me-generate-random-password@127.0.0.1:55434/fdos_local
FDOS_API_HOST=127.0.0.1
FDOS_API_PORT=5012
FDOS_FRONTEND_ORIGIN=http://localhost:3000
VITE_BACKEND_DRIVER=local-postgres

# Phase 3. No outbound messages by default (safe local preview).
FDOS_COMM_MODE=preview
# Live email via Resend: required only when FDOS_COMM_MODE=live.
# RESEND_API_KEY=
# FDOS_EMAIL_FROM=Invoices <invoices@your-verified-domain.com>
# WhatsApp Business Platform: pre-approved templates with 3 body placeholders.
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_GRAPH_VERSION=v23.0
# FDOS_WA_TEMPLATE_DOCUMENT=fdos_document_notice
# FDOS_WA_TEMPLATE_RECEIPT=fdos_receipt_notice
# FDOS_WA_LANGUAGE=en_US
# Required in live mode: HTTPS reachable by your customers (never localhost).
# FDOS_PUBLIC_APP_URL=https://your-domain.example

# Phase 4 eTIMS: PREVIEW (default) or SANDBOX only.
# This app is not a certified OSCU/VSCU and never calls the KRA API directly.
FDOS_ETIMS_MODE=preview
# Set only after you have an authorized KRA sandbox OSCU deployment:
# FDOS_ETIMS_BRIDGE_URL=http://127.0.0.1:5056
# FDOS_ETIMS_BRIDGE_TOKEN=use-a-secret-provisioned-by-your-oscu-bridge
# FDOS_ETIMS_APPROVED_SANDBOX=NO
# FDOS_ETIMS_KRA_CERTIFIED=NO

# Phase 5 — M-Pesa. 'preview' records TEST-ONLY transactions locally.
# 'sandbox' requires an actual Safaricom Daraja developer account.
# Production / live is intentionally DISABLED.
FDOS_MPESA_MODE=preview
# FDOS_MPESA_SHORTCODE=174379
# FDOS_MPESA_SHORTCODE_TYPE=PAYBILL
# FDOS_MPESA_CONSUMER_KEY=
# FDOS_MPESA_CONSUMER_SECRET=
# FDOS_MPESA_PASSKEY=
# FDOS_MPESA_PUBLIC_BASE=https://your-public-https-callback-host.example
# FDOS_MPESA_CALLBACK_TOKEN=generate-a-long-random-32-plus-character-token
# FDOS_MPESA_SANDBOX_APPROVED=NO

# Phase 6: local scheduler creates reminders but external sending remains opt-in.
# A cron/systemd job can invoke scripts/local/run-automation-tick.sh (not installed automatically).
FDOS_AUTOMATION_TIMEZONE=Africa/Nairobi
FDOS_AUTOMATION_LIVE_ENABLED=NO
# Require a second independent explicit approval for unattended real delivery.
FDOS_AUTOMATION_LIVE_APPROVED=NO
# WhatsApp reminder template (3 text body parameters: name, invoice number, link).
# FDOS_WA_TEMPLATE_REMINDER=fdos_payment_reminder
